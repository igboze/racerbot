{
  "name": "racerbot",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@racerbot/position-executor",
    "build:executor": "npm run build --workspace=packages/position-executor",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:db": "npm run build --workspace=packages/db",
    "build:all": "turbo run build",
    "dev:api": "turbo run dev --filter=@racerbot/api",
    "dev:detector": "turbo run dev --filter=@racerbot/detector",
    "dev:executor": "turbo run dev --filter=@racerbot/executor",
    "dev:triggers": "turbo run dev --filter=@racerbot/triggers",
    "typecheck": "turbo run build",
    "format": "prettier --write .",
    "lint": "eslint packages --ext .ts",
    "migrate": "npm run migrate --workspace=packages/db",
    "test": "vitest run",
    "clean:cache": "node -e \"fs.rmSync('.turbo', { recursive: true, force: true }); fs.rmSync('.cargo-target', { recursive: true, force: true }); console.log('Build caches cleared!');\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "near-api-js-v7": "npm:near-api-js@7.3.1",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hot-labs/near-connect": "^0.11.4",
    "@quicknode/sdk": "^3.8.2",
    "canvas": "^3.2.3",
    "helmet": "^8.3.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "secp256k1@5.0.0": true
  }
}
