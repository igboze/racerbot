FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/api/package.json ./packages/api/
COPY packages/contract/package.json ./packages/contract/
COPY packages/db/package.json ./packages/db/
COPY packages/detector/package.json ./packages/detector/
COPY packages/executor/package.json ./packages/executor/
COPY packages/shared/package.json ./packages/shared/
COPY packages/triggers/package.json ./packages/triggers/
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
# turbo emits to packages/<svc>/dist — copy the whole workspace, not /app/dist
COPY --from=builder /app /app
# Triggers is a headless polling engine — no HTTP port to healthcheck
CMD ["node", "packages/triggers/dist/index.js"]
