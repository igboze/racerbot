{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "api": {
      "dockerfile": "Dockerfile.api",
      "ports": [
        {
          "port": 3000
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "66204d17579e9fc4990edd3bcd7dec35194747d051a51eb7f3c3a6eb052ccd83"
        },
        {
          "variable": "RACERBOT_PARENT_ACCOUNT",
          "value": "racerbot.near"
        },
        {
          "variable": "ROUTER_CONTRACT_ID",
          "value": "router.racerbot.near"
        },
        {
          "variable": "TREASURY_ACCOUNT_ID",
          "value": "treasury.racerbot.near"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TELEGRAM_BOT_TOKEN",
          "value": "${{secrets.TELEGRAM_BOT_TOKEN}}"
        },
        {
          "variable": "KEY_ENCRYPTION_MASTER_KEY",
          "value": "${{secrets.KEY_ENCRYPTION_MASTER_KEY}}"
        },
        {
          "variable": "MAIN_WALLET_PRIVATE_KEY",
          "value": "${{secrets.MAIN_WALLET_PRIVATE_KEY}}"
        },
        {
          "variable": "TREASURY_PRIVATE_KEY",
          "value": "${{secrets.TREASURY_PRIVATE_KEY}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "5000"
        },
        {
          "variable": "QUICKNODE_API_KEY",
          "value": "0c22cd8057497654c686680b7e7b1dfd0e3bb9ec"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "QUICKNODE_CHAIN_ID",
          "value": "near-mainnet"
        }
      ]
    },
    "detector": {
      "dockerfile": "Dockerfile.detector",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "66204d17579e9fc4990edd3bcd7dec35194747d051a51eb7f3c3a6eb052ccd83"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "3000"
        }
      ]
    },
    "executor": {
      "dockerfile": "Dockerfile.executor",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "66204d17579e9fc4990edd3bcd7dec35194747d051a51eb7f3c3a6eb052ccd83"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "KEY_ENCRYPTION_MASTER_KEY",
          "value": "${{secrets.KEY_ENCRYPTION_MASTER_KEY}}"
        }
      ]
    },
    "triggers": {
      "dockerfile": "Dockerfile.triggers",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "66204d17579e9fc4990edd3bcd7dec35194747d051a51eb7f3c3a6eb052ccd83"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://falling-frosty-uranium.near-mainnet.quiknode.pro/0c22cd8057497654c686680b7e7b1dfd0e3bb9ec/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "5000"
        }
      ]
    }
  },
  "plugins": {
    "postgresql": {
      "plan": "standard"
    },
    "redis": {
      "plan": "standard"
    }
  }
}