{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "api": {
      "dockerfile": "Dockerfile.api",
      "ports": [
        {
          "port": 3000
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://rpc.shitzuapes.xyz,https://rpc.intea.rs,https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "REDACTED"
        },
        {
          "variable": "RACERBOT_PARENT_ACCOUNT",
          "value": "racerbot.near"
        },
        {
          "variable": "ROUTER_CONTRACT_ID",
          "value": "router.racerbot.near"
        },
        {
          "variable": "TREASURY_ACCOUNT_ID",
          "value": "wild-falcon-5130.racerbot.near"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TELEGRAM_BOT_TOKEN",
          "value": "${{secrets.TELEGRAM_BOT_TOKEN}}"
        },
        {
          "variable": "KEY_ENCRYPTION_MASTER_KEY",
          "value": "${{secrets.KEY_ENCRYPTION_MASTER_KEY}}"
        },
        {
          "variable": "MAIN_WALLET_PRIVATE_KEY",
          "value": "${{secrets.MAIN_WALLET_PRIVATE_KEY}}"
        },
        {
          "variable": "TREASURY_PRIVATE_KEY",
          "value": "${{secrets.TREASURY_PRIVATE_KEY}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "5000"
        },
        {
          "variable": "QUICKNODE_API_KEY",
          "value": "REDACTED"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "QUICKNODE_CHAIN_ID",
          "value": "near-mainnet"
        },
        {
          "variable": "BUBBLE_PUBLIC_URL",
          "value": "https://racerbotbubblemap.buzz"
        },
        {
          "variable": "DISABLE_BACKGROUND_WORKERS",
          "value": "true"
        }
      ]
    },
    "detector": {
      "dockerfile": "Dockerfile.detector",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://rpc.shitzuapes.xyz,https://rpc.intea.rs,https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "REDACTED"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "3000"
        }
      ]
    },
    "executor": {
      "dockerfile": "Dockerfile.executor",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://rpc.shitzuapes.xyz,https://rpc.intea.rs,https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "REDACTED"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "KEY_ENCRYPTION_MASTER_KEY",
          "value": "${{secrets.KEY_ENCRYPTION_MASTER_KEY}}"
        }
      ]
    },
    "triggers": {
      "dockerfile": "Dockerfile.triggers",
      "ports": [
        {
          "port": 8080
        }
      ],
      "environments": [
        {
          "variable": "RPC_PROVIDERS",
          "value": "https://rpc.mainnet.fastnear.com,https://rpc.shitzuapes.xyz,https://rpc.intea.rs,https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "FASTNEAR_API_KEY",
          "value": "REDACTED"
        },
        {
          "variable": "QUICKNODE_ENDPOINT_URL",
          "value": "https://blissful-capable-road.near-mainnet.quiknode.pro/REDACTED/"
        },
        {
          "variable": "DATABASE_URL",
          "value": "${{PostgreSQL.URL}}"
        },
        {
          "variable": "REDIS_URL",
          "value": "${{Redis.URL}}"
        },
        {
          "variable": "TRIGGER_INTERVAL_MS",
          "value": "5000"
        }
      ]
    }
  },
  "plugins": {
    "postgresql": {
      "plan": "standard"
    },
    "redis": {
      "plan": "standard"
    }
  }
}