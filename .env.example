# Environment variables for all RacerBot services

# Multi-RPC Providers
FASTNEAR_API_KEY=your-fastnear-api-key
FASTNEAR_API_URL=https://api.fastnear.com
RPC_PROVIDERS=https://rpc.mainnet.fastnear.com?apiKey=your-fastnear-api-key,https://free.rpc.fastnear.com,https://rpc.ankr.com/near,https://1rpc.io/near,https://rpc.mainnet.near.org

# NEAR Accounts
RACERBOT_PARENT_ACCOUNT=racerbot.near
ROUTER_CONTRACT_ID=router.racerbot.near
TREASURY_ACCOUNT_ID=treasury.racerbot.near

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/racerbot
DATABASE_URL_PRODUCTION=postgresql://${{PostgreSQL_USER}}:${{PostgreSQL_PASSWORD}}@${{PostgreSQL_HOST}}:${{PostgreSQL_PORT}}/${{PostgreSQL_DATABASE}}

# Cache/Message Bus
REDIS_URL=redis://localhost:6379
REDIS_URL_PRODUCTION=rediss://${{Redis_HOST}}:${{Redis_PORT}}/${{Redis_DATABASE}}

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Security
KEY_ENCRYPTION_MASTER_KEY=your-256-bit-master-key-here

# Config
POOL_MIN=5
POOL_MAX=20
IDLE_TIMEOUT=30000
CONN_TIMEOUT=10000
TRIGGER_INTERVAL_MS=5000
HEALTH_CHECK_INTERVAL_MS=30000
NODE_ENV=production