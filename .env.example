# Environment variables template for RacerBot
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO VERSION CONTROL

FASTNEAR_API_KEY=
FASTNEAR_API_URL=https://api.fastnear.com
RPC_PROVIDERS=https://rpc.mainnet.fastnear.com

# QuickNode SDK for faster RPC and WebSocket subscriptions
QUICKNODE_API_KEY=
QUICKNODE_ENDPOINT_URL=
QUICKNODE_CHAIN_ID=near-mainnet

RACERBOT_PARENT_ACCOUNT=
ROUTER_CONTRACT_ID=
TREASURY_ACCOUNT_ID=
MAIN_WALLET_PRIVATE_KEY=

DATABASE_URL=
DATABASE_URL_UNPOOLED=
REDIS_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
KEY_ENCRYPTION_MASTER_KEY=

POOL_MIN=5
POOL_MAX=20
IDLE_TIMEOUT=30000
CONN_TIMEOUT=10000
TRIGGER_INTERVAL_MS=5000
HEALTH_CHECK_INTERVAL_MS=30000
NODE_ENV=production
# ── Admin monitoring ─────────────────────────────────────────────
# Telegram usernames (comma-separated) allowed to run /monitor, /failures, /slow
# and to receive failure-spike / slow-signing alerts.
ADMIN_USERNAMES=israel_igboze
# Optional: numeric Telegram user id that is always treated as admin.
# ADMIN_TELEGRAM_ID=
# How often the background monitor checks trade_attempts (ms, default 5 min).
# MONITOR_INTERVAL_MS=300000

# NEAR Intents / 1Click Cross-Chain Deposit Solver (required for deposit modal)
NEAR_INTENTS_API_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=

# ── Solana ───────────────────────────────────────────────────────
# Paid RPC (QuickNode). Only used as a LAST-RESORT fallback when every free
# endpoint below fails, so in normal operation it consumes no credits.
SOLANA_RPC_URL=
# Free read/broadcast endpoints, tried first (comma-separated).
# Default: https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com
# SOLANA_READ_RPC_URLS=
# Set to false to never touch the paid RPC at all.
# SOLANA_PAID_RPC_FALLBACK=true
# Dev wallet that receives the platform fee in SOL (1.5% buys, 1.5%/2% sells, same as NEAR).
SOLANA_DEV_FEE_WALLET=5ba1CAazPrdYYcaTYyzTqMExgCadu2aFauW24r28dh5g
# Optional free Jupiter API key (portal: https://developers.jup.ag/portal).
# Without it the keyless lite API is used (about 1 request every 2 seconds).
# JUPITER_API_KEY=
# Quick-buy buttons on Solana token cards (SOL amounts).
# SOLANA_BUY_PRESETS=0.1,0.25,0.5,1
# Priority fee level for swaps: medium | high | veryHigh
# SOLANA_PRIORITY_LEVEL=high
# Solana automation (all optional; defaults shown). These use free APIs / free RPC only.
# Snipe watchdog tick and the oldest pump.fun launch a deployer snipe may still buy:
# SOLANA_SNIPE_TICK_MS=3000
# SOLANA_SNIPE_MAX_LAUNCH_AGE_MS=300000
# Copy trading: skip copies of leader trades older than this, and free-RPC calls per second:
# SOLANA_COPY_MAX_AGE_MS=90000
# SOLANA_COPY_RPC_RPS=4
# Limit orders: how often Solana prices are refreshed (one batched Jupiter call):
# SOLANA_LIMIT_REFRESH_MS=8000

# Private (router) sells are on for everyone; set to false only as an emergency off switch
PRIVATE_SELLS_ENABLED=true

# Confidential trading with per-position executors (packages/position-executor).
# Leave false until the executor global contract and the router upgrade are deployed.
CONFIDENTIAL_EXECUTORS_ENABLED=true
EXECUTOR_CODE_HASH=812af58d8779a100dbcf61c94d9155f93f32bd4b2ecb00255b48d50e71888d7e
# Dedicated relayer that signs executor trades and pays their gas (allow it with router.set_relayer)
EXECUTOR_RELAYER_ACCOUNT_ID=
EXECUTOR_RELAYER_PRIVATE_KEY=
# Or several relayer accounts so split and fleet buys go out in parallel (each allowed with set_relayer):
# EXECUTOR_RELAYERS=relayer1.near=ed25519:...,relayer2.near=ed25519:...

# ── HyperEVM & Elysium (Kinetiq L2) ───────────────────────────────
# EVM Treasury wallet that receives the 1.5% platform fee on HyperEVM and Elysium swaps
EVM_TREASURY_ADDRESS=0xb1f9551E64e1addF18462B09f04E14DC131451b1

# HyperEVM RPC URL (Default: https://rpc.hyperliquid.xyz/evm)
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Elysium L2 RPC URL (Testnet Default: https://testnet-rpc.elysium.kinetiq.xyz)
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
